rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    // Path Variable Hardening (Id Poisoning Guard)
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.:@]+$');
    }

    // Validation Blueprint
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Entity Validations with size & type guards
    function isValidInstitution(data) {
      return (data.name is string && data.name.size() > 0) || (data.tradeName is string && data.tradeName.size() > 0);
    }

    function isValidStudent(data) {
      return data.name is string && data.name.size() > 0;
    }

    function isValidClass(data) {
      return data.name is string && data.name.size() > 0;
    }

    function isValidEnrollment(data) {
      return (data.studentId is number || data.studentId is string) && (data.classId is number || data.classId is string);
    }

    function isValidPayment(data) {
      return (data.amount is number || data.amount is string);
    }

    function isValidProvider(data) {
      return (data.legalName is string && data.legalName.size() > 0) || 
             (data.commercialName is string && data.commercialName.size() > 0) || 
             (data.name is string && data.name.size() > 0);
    }

    function isValidCRMLead(data) {
      return data.name is string && data.name.size() > 0;
    }

    function isValidContact(data) {
      return data.name is string && data.name.size() > 0;
    }

    function isValidTask(data) {
      return data.title is string && data.title.size() > 0;
    }

    function isValidActivity(data) {
      return data.description is string && data.description.size() > 0;
    }

    function isValidAuditLog(data) {
      return data.description is string && data.description.size() > 0;
    }

    function isValidFinancialTransaction(data) {
      return data.amount is number || data.amount is string;
    }

    function isValidBankAccount(data) {
      return data.bankName is string && data.bankName.size() > 0;
    }

    function isValidUser(data) {
      return data.name is string && data.name.size() > 0 && data.email is string && data.email.size() > 0;
    }

    function isValidProviderProductService(data) {
      return data.providerId != null;
    }

    function isValidProviderSpecificProduct(data) {
      return data.providerId != null;
    }

    function isValidEmailId(email) {
      return email is string && email.size() <= 150 && email.matches('^[a-zA-Z0-9_\\.\\-]+@[a-zA-Z0-9_\\.\\-]+$');
    }

    function isValidOTPRequest(data) {
      return data.code is string && data.code.size() == 6 && data.expiresAt is string;
    }

    // Relaxed ID check to support Spanish accented characters, spaces, and brackets for catalogs
    function isValidCatalogId(id) {
      return id is string && id.size() <= 128;
    }

    function isValidCompanyDocument(data) {
      return data.name is string && data.name.size() > 0;
    }

    function isValidFinanceCategory(data) {
      return data.name is string && data.name.size() > 0;
    }

    function isValidAccountStatement(data) {
      return true;
    }

    function isValidStatementTransaction(data) {
      return true;
    }

    function isValidCompanyInfo(data) {
      return data.commercialName is string || data.legalName is string || data.rfc is string;
    }

    function isValidCatalog(data) {
      return data.items is list;
    }

    function isValidBackup(data) {
      return data.date is string && data.type is string;
    }

    function isValidSystemRole(data) {
      return data.name is string && data.name.size() > 0 && data.permissions is map;
    }

    // Match pathways configurations
    match /test/{id} {
      allow read: if true;
    }

    match /system/{id} {
      allow read: if true;
    }

    match /system_roles/{id} {
      allow read: if true;
      allow create, update: if isValidId(id) && isValidSystemRole(incoming());
      allow delete: if isValidId(id);
    }

    match /institutions/{id} {
      allow read: if true;
      allow create, update: if isValidId(id) && isValidInstitution(incoming());
      allow delete: if isValidId(id);
    }

    match /students/{id} {
      allow read: if true;
      allow create, update: if isValidId(id) && isValidStudent(incoming());
      allow delete: if isValidId(id);
    }

    match /classes/{id} {
      allow read: if true;
      allow create, update: if isValidId(id) && isValidClass(incoming());
      allow delete: if isValidId(id);
    }

    match /enrollments/{id} {
      allow read: if true;
      allow create, update: if isValidId(id) && isValidEnrollment(incoming());
      allow delete: if isValidId(id);
    }

    match /payments/{id} {
      allow read: if true;
      allow create, update: if isValidId(id) && isValidPayment(incoming());
      allow delete: if isValidId(id);
    }

    match /providers/{id} {
      allow read: if true;
      allow create, update: if isValidId(id) && isValidProvider(incoming());
      allow delete: if isValidId(id);
    }

    match /bankAccounts/{id} {
      allow read: if true;
      allow create, update: if isValidId(id) && isValidBankAccount(incoming());
      allow delete: if isValidId(id);
    }

    match /crmLeads/{id} {
      allow read: if true;
      allow create, update: if isValidId(id) && isValidCRMLead(incoming());
      allow delete: if isValidId(id);
    }

    match /contacts/{id} {
      allow read: if true;
      allow create, update: if isValidId(id) && isValidContact(incoming());
      allow delete: if isValidId(id);
    }

    match /tasks/{id} {
      allow read: if true;
      allow create, update: if isValidId(id) && isValidTask(incoming());
      allow delete: if isValidId(id);
    }

    match /activities/{id} {
      allow read: if true;
      allow create, update: if isValidId(id) && isValidActivity(incoming());
      allow delete: if isValidId(id);
    }

    match /auditLogs/{id} {
      allow read: if true;
      allow create, update: if isValidId(id) && isValidAuditLog(incoming());
      allow delete: if isValidId(id);
    }

    match /financialTransactions/{id} {
      allow read: if true;
      allow create, update: if isValidId(id) && isValidFinancialTransaction(incoming());
      allow delete: if isValidId(id);
    }

    match /users/{id} {
      allow read: if true;
      allow create, update: if isValidId(id) && isValidUser(incoming());
      allow delete: if isValidId(id);
    }

    match /providerProductServices/{id} {
      allow read: if true;
      allow create, update: if isValidId(id) && isValidProviderProductService(incoming());
      allow delete: if isValidId(id);
    }

    match /providerSpecificProducts/{id} {
      allow read: if true;
      allow create, update: if isValidId(id) && isValidProviderSpecificProduct(incoming());
      allow delete: if isValidId(id);
    }

    match /temporary_otps/{email} {
      // Handled via single-document operations, allowing get / create / update / delete for client-side OTP matching
      allow get: if isValidEmailId(email);
      allow create, update: if isValidEmailId(email) && isValidOTPRequest(incoming());
      allow delete: if isValidEmailId(email);
    }

    match /companyInfo/{id} {
      allow read: if true;
      allow create, update: if isValidId(id) && isValidCompanyInfo(incoming());
      allow delete: if isValidId(id);
    }

    match /companyDocuments/{id} {
      allow read: if true;
      allow create, update: if isValidId(id) && isValidCompanyDocument(incoming());
      allow delete: if isValidId(id);
    }

    match /financeCategories/{id} {
      allow read: if true;
      allow create, update: if isValidId(id) && isValidFinanceCategory(incoming());
      allow delete: if isValidId(id);
    }

    match /accountStatements/{id} {
      allow read: if true;
      allow create, update: if isValidId(id) && isValidAccountStatement(incoming());
      allow delete: if isValidId(id);
    }

    match /statementTransactions/{id} {
      allow read: if true;
      allow create, update: if isValidId(id) && isValidStatementTransaction(incoming());
      allow delete: if isValidId(id);
    }

    match /catalogs/{id} {
      allow read: if true;
      allow create, update: if isValidCatalogId(id) && isValidCatalog(incoming());
      allow delete: if isValidCatalogId(id);
    }

    match /app_backups/{id} {
      allow read: if true;
      allow create, update: if isValidId(id) && isValidBackup(incoming());
      allow delete: if isValidId(id);
    }
  }
}
