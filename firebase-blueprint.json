{
  "entities": {
    "Institution": {
      "title": "Institution",
      "description": "Represents an educational institution or commercial partner.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "contactName": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "Student": {
      "title": "Student",
      "description": "Represents an individual student registered in programs.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "institutionId": { "type": "string" }
      },
      "required": ["id", "firstName", "lastName"]
    },
    "Class": {
      "title": "Class",
      "description": "Represents an educational class or program slot.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "teacher": { "type": "string" },
        "schedule": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "Enrollment": {
      "title": "Enrollment",
      "description": "Represents a student enrolled in a specific class.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "classId": { "type": "string" },
        "date": { "type": "string" }
      },
      "required": ["id", "studentId", "classId"]
    },
    "Payment": {
      "title": "Payment",
      "description": "Financial payment transaction records.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "amount": { "type": "number" },
        "date": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "amount", "date"]
    },
    "Provider": {
      "title": "Provider",
      "description": "An administrative service or system provider.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "serviceType": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "CRMLead": {
      "title": "CRMLead",
      "description": "A lead or potential educational client in the CRM pipeline.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "contactName": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "Contact": {
      "title": "Contact",
      "description": "Represents an institution's focal contact person.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "Task": {
      "title": "Task",
      "description": "An administrative follow-up task or reminder.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "title"]
    },
    "Activity": {
      "title": "Activity",
      "description": "System audit trail and institution log.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "description": { "type": "string" },
        "date": { "type": "string" }
      },
      "required": ["id", "description"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "System-wide tracking of critical changes to financial transactions or provider details.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "entityType": { "type": "string" },
        "entityId": { "type": "string" },
        "date": { "type": "string" },
        "description": { "type": "string" },
        "userName": { "type": "string" }
      },
      "required": ["id", "entityType", "description"]
    },
    "FinancialTransaction": {
      "title": "FinancialTransaction",
      "description": "General system financial ledger item.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "amount": { "type": "number" },
        "type": { "type": "string" }
      },
      "required": ["id", "amount", "type"]
    },
    "BankAccount": {
      "title": "BankAccount",
      "description": "Represents a bank account associated with a provider.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "providerId": { "type": "number" },
        "bankName": { "type": "string" },
        "accountName": { "type": "string" },
        "accountNumber": { "type": "string" },
        "clabe": { "type": "string" },
        "reference": { "type": "string" }
      },
      "required": ["id", "bankName", "accountName", "accountNumber"]
    },
    "OTPRequest": {
      "title": "OTPRequest",
      "description": "Information about a requested OTP verification code.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "expiresAt": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "code", "expiresAt"]
    },
    "User": {
      "title": "User",
      "description": "System users and authorization roles.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" },
        "password": { "type": "string" },
        "requirePasswordChange": { "type": "boolean" },
        "requireEmailVerification": { "type": "boolean" },
        "emailVerified": { "type": "boolean" }
      },
      "required": ["id", "name", "email", "role"]
    },
    "Backup": {
      "title": "Backup",
      "description": "Metadata about system database backup snapshot.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "type": { "type": "string" },
        "size": { "type": "string" },
        "records": { "type": "number" }
      },
      "required": ["id", "date", "type", "size", "records"]
    },
    "SystemRole": {
      "title": "SystemRole",
      "description": "System role definitions and granular module permissions.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "permissions": { "type": "object" }
      },
      "required": ["id", "name", "permissions"]
    }
  },
  "firestore": {
    "system_roles": {
      "schema": "SystemRole",
      "description": "Role definitions with granular access controls and permissions"
    },
    "institutions": {
      "schema": "Institution",
      "description": "Educational institutions and enterprise prospects"
    },
    "students": {
      "schema": "Student",
      "description": "Registered students roster"
    },
    "classes": {
      "schema": "Class",
      "description": "Offered programs and schedules"
    },
    "enrollments": {
      "schema": "Enrollment",
      "description": "Links between students and their classes"
    },
    "payments": {
      "schema": "Payment",
      "description": "Finance and tuitions payment records"
    },
    "providers": {
      "schema": "Provider",
      "description": "Service suppliers and platform connections"
    },
    "bankAccounts": {
      "schema": "BankAccount",
      "description": "Bank account registration details associated with providers"
    },
    "crmLeads": {
      "schema": "CRMLead",
      "description": "Leads in the sales pipeline"
    },
    "contacts": {
      "schema": "Contact",
      "description": "Focal institution contact directories"
    },
    "tasks": {
      "schema": "Task",
      "description": "Action items and follow-up activities"
    },
    "activities": {
      "schema": "Activity",
      "description": "Audit trails and historical event lists"
    },
    "auditLogs": {
      "schema": "AuditLog",
      "description": "System audit logs for core state changes such as Payment modifications or Provider changes"
    },
    "financialTransactions": {
      "schema": "FinancialTransaction",
      "description": "Cash ledger of incomes and expenses"
    },
    "providerProductServices": {
      "schema": "object",
      "description": "Catalog of rates and services offered by educational providers by country"
    },
    "providerSpecificProducts": {
      "schema": "object",
      "description": "Custom provider-specific products and platforms"
    },
    "temporary_otps": {
      "schema": "OTPRequest",
      "description": "One-time password codes for passwordless authentication"
    },
    "users": {
      "schema": "User",
      "description": "System users catalog supporting credentials, auto-passwords, and roles"
    },
    "companyInfo": {
      "schema": "object",
      "description": "Company registration and configuration details"
    },
    "companyDocuments": {
      "schema": "object",
      "description": "Company document metadata and records"
    },
    "financeCategories": {
      "schema": "object",
      "description": "Financial categorization and subcategory rules"
    },
    "accountStatements": {
      "schema": "object",
      "description": "Imported banking account statement sheets"
    },
    "statementTransactions": {
      "schema": "object",
      "description": "Granular operation entries compiled from statements"
    },
    "catalogs": {
      "schema": "object",
      "description": "Flexible drop-down dictionaries and country fees"
    },
    "app_backups": {
      "schema": "Backup",
      "description": "History and metadata of generated database backups"
    }
  }
}
